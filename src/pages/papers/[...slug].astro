---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import MobileToc from '../../components/MobileToc.astro';

export async function getStaticPaths() {
  const papers = await getCollection('papers', ({ data }) => !data.draft);
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: paper,
  }));
}

type Props = CollectionEntry<'papers'>;

const paper = Astro.props;
const { data } = paper;
const { Content, headings } = await render(paper);

const readingMinutes = Math.max(1, Math.round((paper.body ?? '').replace(/\s/g, '').length / 400));

const sourceTypeMeta = {
  paper: { emoji: '📄', label: '论文精读', class: 'bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-300' },
  blog: { emoji: '📝', label: '博客精读', class: 'bg-teal-50 dark:bg-teal-500/10 text-teal-600 dark:text-teal-300' },
  docs: { emoji: '📘', label: '文档精读', class: 'bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-300' },
} as const;

const meta = sourceTypeMeta[data.sourceType];
const getPath = (path: string) => {
  const base = import.meta.env.BASE_URL;
  return base === '/' ? path : `${base.replace(/\/$/, '')}${path}`;
};
---

<Layout title={`${data.title} - AIInfraGuide`} description={data.description}>

  <div class="docs-shell content-layout paper-content max-w-[1400px] mx-auto px-6 py-12 flex gap-10">
    <!-- Main Content -->
    <article class="content-article flex-1 min-w-0">
      <!-- 移动端折叠目录 -->
      <MobileToc headings={headings} />

      <!-- Back to list -->
      <a href={getPath('/papers')} class="inline-flex items-center gap-1.5 text-sm text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        返回 Paper 精读
      </a>

      <!-- Article Header -->
      <header class="content-header mb-10 pb-8 border-b border-gray-200 dark:border-white/[0.06]">
        <div class="flex items-center gap-3 mb-5 flex-wrap">
          <span class={`inline-flex items-center px-3 py-1 text-xs font-medium rounded-md ${meta.class}`}>
            <span class="classic-only-emoji">{meta.emoji} </span>{meta.label}
          </span>
          {data.originalAuthor && (
            <span class="text-xs text-gray-400 dark:text-gray-500">作者: {data.originalAuthor}</span>
          )}
          <time class="text-xs text-gray-400 dark:text-gray-500" datetime={data.pubDate.toISOString()}>
            {data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            约 {readingMinutes} 分钟
          </span>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
          {data.title}
        </h1>

        <p class="text-lg text-gray-500 dark:text-gray-400 leading-relaxed">
          {data.description}
        </p>

        <div class="flex gap-2 mt-5 flex-wrap">
          <a
            href={data.originalUrl}
            target="_blank"
            rel="nofollow noopener"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-300 text-sm font-medium hover:bg-indigo-100 dark:hover:bg-indigo-500/20 transition-colors"
          >
            阅读原文 ↗
          </a>
          {data.tags.map((tag) => (
            <span class="px-2.5 py-1 bg-gray-50 dark:bg-white/[0.04] border border-gray-200 dark:border-white/[0.08] text-xs text-gray-500 dark:text-gray-400 rounded-md font-medium">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Article Body -->
      <div
        class="content-prose prose prose-gray dark:prose-invert max-w-[75ch] mx-auto
          prose-headings:font-bold prose-headings:text-gray-900 dark:prose-headings:text-white
          prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-3 prose-h2:pb-3 prose-h2:border-b prose-h2:border-gray-100 dark:prose-h2:border-white/[0.06]
          prose-h3:text-xl prose-h3:mt-6
          prose-p:leading-[1.6] prose-p:text-gray-600 dark:prose-p:text-gray-300
          prose-li:text-gray-600 dark:prose-li:text-gray-300
          prose-a:text-[#007aff] dark:prose-a:text-[#0a84ff] prose-a:no-underline prose-a:font-medium hover:prose-a:underline
          prose-strong:text-gray-900 dark:prose-strong:text-white
          prose-hr:border-gray-100 dark:prose-hr:border-white/[0.06]
          prose-blockquote:border-l-[#007aff] prose-blockquote:bg-blue-50/50 dark:prose-blockquote:bg-blue-900/10 prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:not-italic
          prose-code:text-[#007aff] dark:prose-code:text-[#0a84ff] prose-code:bg-blue-50 dark:prose-code:bg-blue-900/20 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[0.875em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
          prose-img:rounded-xl prose-img:border prose-img:border-gray-200 dark:prose-img:border-white/[0.08] prose-img:shadow-sm
          prose-pre:!p-0 prose-pre:!m-0
          prose-table:text-sm prose-th:bg-gray-50 dark:prose-th:bg-white/[0.04] prose-th:px-4 prose-th:py-2.5 prose-td:px-4 prose-td:py-2.5"
      >
        <Content />
      </div>
    </article>

    <!-- Right Sidebar: TOC -->
    <aside class="hidden xl:block">
      <TableOfContents headings={headings} />
    </aside>
  </div>
</Layout>
