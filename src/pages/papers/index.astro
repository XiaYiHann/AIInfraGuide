---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PaperCard from '../../components/PaperCard.astro';

const papers = (await getCollection('papers', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Paper 精读 - AIInfraGuide" description="论文与技术博客的中文通俗精读:用'工程师给工程师讲课'的方式重述原文,保留全部关键事实,补上直觉与上下文">
  <section class="collection-landing paper-landing relative pt-28 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-6">
      <header class="collection-header max-w-2xl mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="classic-only-emoji text-2xl">📖</span>
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">Paper 精读</h1>
        </div>
        <p class="text-lg text-gray-500 dark:text-gray-400 leading-relaxed">
          论文与技术博客的中文通俗精读——保留原文全部关键事实,补上直觉、比喻与上下文,不查原文也能读懂。
        </p>
      </header>

      {papers.length > 0 ? (
        <div class="collection-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {papers.map((paper) => (
            <PaperCard paper={paper} />
          ))}
        </div>
      ) : (
        <div class="py-20 text-center text-gray-400 dark:text-gray-500">
          精读文章正在路上,敬请期待
        </div>
      )}
    </div>
  </section>
</Layout>
