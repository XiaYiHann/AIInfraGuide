---
import Layout from '../../layouts/Layout.astro';

const getPath = (path: string) => {
  const base = import.meta.env.BASE_URL;
  return base === '/' ? path : `${base.replace(/\/$/, '')}${path}`;
};

---

<Layout title="关于 Ethan - AIInfraGuide" description="关于 AIInfraGuide 维护者 Ethan">
  <div class="about-page relative overflow-hidden">
    <div class="decorative-effects absolute inset-0 pointer-events-none -z-10">
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-blue-500/[0.07] dark:bg-blue-500/[0.10] rounded-full blur-[120px]"></div>
      <div class="absolute top-40 right-1/4 w-[400px] h-[400px] bg-violet-500/[0.05] dark:bg-violet-500/[0.09] rounded-full blur-[120px]"></div>
    </div>

    <article class="standalone-article about-content py-24 max-w-3xl mx-auto px-6">
      <header class="standalone-header identity-header mb-16 text-center">
        <div class="identity-avatar inline-flex items-center justify-center w-24 h-24 mb-6 rounded-2xl overflow-hidden shadow-lg shadow-blue-500/20 ring-1 ring-gray-200/60 dark:ring-white/10">
          <img
            src={getPath('/images/ethan-ai-researcher.webp')}
            alt="Ethan AI Researcher 标识"
            width="512"
            height="512"
            class="w-full h-full object-cover"
          />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-gray-900 dark:text-white">
          Ethan
        </h1>
        <p class="text-base md:text-lg text-gray-500 dark:text-gray-400 mb-6">
          AI Researcher
        </p>
      </header>

      <section class="mb-16">
        <h2 class="flex items-center gap-2.5 text-xl font-bold text-gray-900 dark:text-white mb-6">
          <span class="w-1 h-5 rounded-full bg-[#007aff]"></span>
          项目链接
        </h2>
        <a
          href="https://github.com/XiaYiHann/AIInfraGuide"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card group relative flex items-center gap-4 p-5 rounded-2xl border border-gray-200 dark:border-white/[0.06] bg-white dark:bg-white/[0.03] hover:border-[#007aff]/40 dark:hover:border-[#0a84ff]/40 hover:shadow-lg hover:shadow-blue-500/5 transition-all duration-200 cursor-pointer"
        >
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-100 dark:bg-white/[0.06] text-gray-700 dark:text-gray-200">
            <svg class="w-[22px] h-[22px]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </span>
          <span>
            <span class="block text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500 mb-1">GitHub</span>
            <span class="block text-[15px] font-semibold text-gray-900 dark:text-white">XiaYiHann/AIInfraGuide</span>
          </span>
          <svg class="w-4 h-4 ml-auto text-gray-300 dark:text-gray-600 group-hover:text-[#007aff] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </section>

      <div class="pt-8 border-t border-gray-200 dark:border-white/[0.06] flex justify-end">
        <a
          href={getPath('/about/roadmap')}
          class="group flex items-center gap-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-[#007aff] dark:hover:text-[#0a84ff] transition-colors duration-200 cursor-pointer"
        >
          教程更新计划
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </article>
  </div>
</Layout>
