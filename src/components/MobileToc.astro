---
// 移动端折叠目录:xl 以下显示在正文顶部
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <details class="mobile-toc xl:hidden my-6 rounded-xl border border-gray-200 dark:border-white/[0.08] bg-gray-50/60 dark:bg-white/[0.03]">
    <summary class="flex items-center justify-between px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
      <span class="flex items-center gap-2">
        <span class="classic-only-emoji text-base">📑</span> 本章目录
      </span>
      <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </summary>
    <ul class="px-4 pb-3 space-y-1">
      {filtered.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class="block py-1 text-[13px] leading-snug text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200"
          >
            <span class:list={[heading.depth === 3 ? 'pl-5' : '', heading.depth === 3 ? 'text-gray-400 dark:text-gray-500' : 'font-medium text-gray-700 dark:text-gray-300']}>
              {heading.text}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </details>
)}
